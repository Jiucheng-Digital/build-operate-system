# 页面标题
VITE_APP_TITLE = 建筑操作系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 接口地址（prod 生产环境：https://test-ai.neucityai.com/test_neucity + 网关上下文 /api）
VITE_APP_BASE_API = '/neucity/api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 用户管理的人脸特征提取服务（沿用云平台环境配置）
VITE_APP_FACE_API_URL = 'http://10.8.8.3:30080/algo/face_recognition/extract'
