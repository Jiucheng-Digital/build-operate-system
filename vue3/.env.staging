# 页面标题
VITE_APP_TITLE = 运营管理系统

# 生产环境配置
VITE_APP_ENV = 'staging'

# 接口地址（dev 测试环境：https://test-ai.neucityai.com/neucity + 网关上下文 /api）
VITE_APP_BASE_API = '/neucity/api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 用户管理的人脸特征提取服务（沿用云平台环境配置）
VITE_APP_FACE_API_URL = 'https://service.neucityai.com:30080/algo/face_recognition/extract'
