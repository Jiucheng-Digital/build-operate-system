{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client"]
  },
  "include": ["src/views/desktop/apps/SpaceEditor/**/*.ts", "src/views/desktop/apps/SpaceEditor/**/*.vue", "src/views/desktop/spatial-view.ts", "src/views/desktop/operational-space.ts"]
}
